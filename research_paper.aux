\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Integrator comparison over 100\nobreakspace  {}s of simulation. Energy drift is reported as the maximum relative deviation from the initial energy. \textbf  {Bold} indicates the best result for each step size.\relax }}{7}{table.caption.16}\protected@file@percent }
\newlabel{tab:integrators}{{5}{7}{Integrator comparison over 100~s of simulation. Energy drift is reported as the maximum relative deviation from the initial energy. \textbf {Bold} indicates the best result for each step size.\relax }{table.caption.16}{}}
\citation{stachowiak2006numerical}
\citation{stachowiak2006numerical}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Comparison of RK45 (adaptive) and symplectic (implicit midpoint) integrators over 100\nobreakspace  {}s at three step sizes. The symplectic integrator shows bounded energy drift that decreases as $O(h^2)$ with step size, while RK45 maintains near-constant accuracy due to adaptive internal stepping. The key advantage of the symplectic method is that its energy error remains bounded over arbitrarily long integration horizons.\relax }}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:integrator}{{3}{8}{Comparison of RK45 (adaptive) and symplectic (implicit midpoint) integrators over 100~s at three step sizes. The symplectic integrator shows bounded energy drift that decreases as $O(h^2)$ with step size, while RK45 maintains near-constant accuracy due to adaptive internal stepping. The key advantage of the symplectic method is that its energy error remains bounded over arbitrarily long integration horizons.\relax }{figure.caption.15}{}}
