\@writefile{toc}{\contentsline {subsection}{\numberline {6.6}Flip-Count Basin Map}{11}{subsection.6.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Flip-count basin map showing the number of complete $2\pi $ rotations of the second bob during a 10\nobreakspace  {}s simulation, as a function of initial angles $(\theta _1, \theta _2)$ with zero initial velocities. The fractal-like boundaries between differently colored regions demonstrate extreme sensitivity to initial conditions. The maximum observed flip count is 15, with the most active regions concentrated near $(\pm \pi , \pm \pi )$ where the initial potential energy is highest.\relax }}{11}{figure.caption.21}\protected@file@percent }
\newlabel{fig:flipmap}{{7}{11}{Flip-count basin map showing the number of complete $2\pi $ rotations of the second bob during a 10~s simulation, as a function of initial angles $(\theta _1, \theta _2)$ with zero initial velocities. The fractal-like boundaries between differently colored regions demonstrate extreme sensitivity to initial conditions. The maximum observed flip count is 15, with the most active regions concentrated near $(\pm \pi , \pm \pi )$ where the initial potential energy is highest.\relax }{figure.caption.21}{}}
