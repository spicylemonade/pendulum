\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Baseline double pendulum trajectory over 30\nobreakspace  {}s with moderate-energy initial conditions ($\theta _1 = \pi /4$, $\theta _2 = \pi /2$). \textbf  {Top:} Angular displacement time series for both bobs, showing irregular oscillations characteristic of chaotic dynamics. \textbf  {Bottom:} Phase portrait $(\theta _1, \omega _1)$ showing space-filling behavior within a bounded region.\relax }}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:baseline}{{2}{7}{Baseline double pendulum trajectory over 30~s with moderate-energy initial conditions ($\theta _1 = \pi /4$, $\theta _2 = \pi /2$). \textbf {Top:} Angular displacement time series for both bobs, showing irregular oscillations characteristic of chaotic dynamics. \textbf {Bottom:} Phase portrait $(\theta _1, \omega _1)$ showing space-filling behavior within a bounded region.\relax }{figure.caption.13}{}}
