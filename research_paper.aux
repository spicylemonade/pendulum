\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Poincar\'e Section}{8}{subsection.6.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Exponential divergence of nearby trajectories in the double pendulum. Two simulations differing by $10^{-9}$\nobreakspace  {}rad in $\theta _1$ show a clear exponential growth phase (linear on the log scale) before saturating at $O(1)$\nobreakspace  {}rad separation. The initial linear regime confirms deterministic chaos, with a divergence time scale consistent with the computed Lyapunov exponent.\relax }}{9}{figure.caption.17}\protected@file@percent }
\newlabel{fig:chaos}{{4}{9}{Exponential divergence of nearby trajectories in the double pendulum. Two simulations differing by $10^{-9}$~rad in $\theta _1$ show a clear exponential growth phase (linear on the log scale) before saturating at $O(1)$~rad separation. The initial linear regime confirms deterministic chaos, with a divergence time scale consistent with the computed Lyapunov exponent.\relax }{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Lyapunov exponent heatmap across 20 combinations of mass ratio ($m_2/m_1$) and length ratio ($l_2/l_1$). Higher mass ratios and shorter second links generally produce stronger chaos (larger $\lambda _1$). The maximum exponent ($\lambda _1 = 2.15$\nobreakspace  {}s$^{-1}$) occurs at $m_2/m_1 = 10$ and $l_2/l_1 = 0.1$, while the minimum ($\lambda _1 = 0.11$\nobreakspace  {}s$^{-1}$) occurs at $m_2/m_1 = 0.1$ and $l_2/l_1 = 2.0$.\relax }}{9}{figure.caption.18}\protected@file@percent }
\newlabel{fig:sensitivity}{{5}{9}{Lyapunov exponent heatmap across 20 combinations of mass ratio ($m_2/m_1$) and length ratio ($l_2/l_1$). Higher mass ratios and shorter second links generally produce stronger chaos (larger $\lambda _1$). The maximum exponent ($\lambda _1 = 2.15$~s$^{-1}$) occurs at $m_2/m_1 = 10$ and $l_2/l_1 = 0.1$, while the minimum ($\lambda _1 = 0.11$~s$^{-1}$) occurs at $m_2/m_1 = 0.1$ and $l_2/l_1 = 2.0$.\relax }{figure.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Selected Lyapunov exponents $\lambda _1$ (s$^{-1}$) for representative parameter combinations. All values are positive, confirming chaos.\relax }}{10}{table.caption.19}\protected@file@percent }
\newlabel{tab:lyapunov_selected}{{6}{10}{Selected Lyapunov exponents $\lambda _1$ (s$^{-1}$) for representative parameter combinations. All values are positive, confirming chaos.\relax }{table.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Poincar\'e section of the double pendulum, recording $(\theta _2, \omega _2)$ at each upward zero-crossing of $\theta _1$. Six initial conditions are shown with different colors. The coexistence of smooth elliptical islands (regular motion) and scattered points (chaotic sea) is characteristic of a Hamiltonian system with mixed phase space, consistent with observations by \citet  {stachowiak2006numerical}.\relax }}{10}{figure.caption.20}\protected@file@percent }
\newlabel{fig:poincare}{{6}{10}{Poincar\'e section of the double pendulum, recording $(\theta _2, \omega _2)$ at each upward zero-crossing of $\theta _1$. Six initial conditions are shown with different colors. The coexistence of smooth elliptical islands (regular motion) and scattered points (chaotic sea) is characteristic of a Hamiltonian system with mixed phase space, consistent with observations by \citet {stachowiak2006numerical}.\relax }{figure.caption.20}{}}
